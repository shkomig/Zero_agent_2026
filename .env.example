# Zero Agent — local environment overrides.
# Copy this file to ".env" (same folder) and fill in the values you need.
# telegram_bot.py loads this file at startup; real environment variables win.

# --- Telegram bridge (telegram_bot.py) -------------------------------------
# 1. Create a bot with @BotFather in Telegram and paste its token here.
ZERO_AGENT_TELEGRAM_TOKEN=123456789:PASTE-YOUR-BOTFATHER-TOKEN-HERE

# 2. Your numeric Telegram user ID(s), comma-separated. REQUIRED for safety —
#    the agent can run shell commands and touch files, so only these IDs are
#    served. Don't know your ID? Leave this empty, start the bot, message it
#    once, and it will reply with your ID. Then paste it here and restart.
ZERO_AGENT_TELEGRAM_ALLOWED_IDS=

# Optional: model used for Telegram chats (defaults to ZERO_AGENT_MODEL).
# ZERO_AGENT_TELEGRAM_MODEL=qwen3:4b

# Optional: long-poll timeout in seconds (how long Telegram holds an idle poll).
# ZERO_AGENT_TELEGRAM_POLL=30

# --- Shared (apply to every entry point) -----------------------------------
# ZERO_AGENT_MODEL=qwen3:4b
# OLLAMA_HOST=http://localhost:11434
# COMFYUI_HOST=http://127.0.0.1:8188
